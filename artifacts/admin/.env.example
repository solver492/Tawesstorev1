# Backend de gestion Tawes — copie en .env puis renseigne les valeurs.

# Cle anon Supabase : lecture + ecriture verifiees (RLS ouvert sur cette base).
SUPABASE_URL=https://nfoefhwmgjatbqyibclp.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=product-media

# Mot de passe du backend de gestion.
ADMIN_PASSWORD=change-me

# Marge ajoutee au prix de gros pour le prix de vente propose.
MARGIN_DH=10

# Origine autorisee (le site public, si l'admin est sur un sous-domaine).
ADMIN_ALLOWED_ORIGIN=*

# Token Vimeo : obligatoire uniquement pour diffuser les videos.
# https://developer.vimeo.com/apps -> Your Apps -> App Server -> Access Token
VIMEO_ACCESS_TOKEN=

PORT=4000
NODE_ENV=production
